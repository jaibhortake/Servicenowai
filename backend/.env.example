# Copy to backend/.env and fill in. backend/.env is git-ignored - never commit it.

# --- ServiceNow (free Personal Developer Instance: https://developer.servicenow.com) ---
SERVICENOW_INSTANCE_URL=https://devXXXXXX.service-now.com
SERVICENOW_USERNAME=admin
# Quote the value if it contains special characters (# % = $)
SERVICENOW_PASSWORD='your-pdi-admin-password'
SERVICENOW_VERIFY_SSL=false
SERVICENOW_WEBHOOK_SECRET=change-this-shared-secret

# --- Portal login (the app's own sign-in) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pass@123
# Long random string used to sign login tokens:  python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=480

# --- LLM: Ollama (local, default) with Groq as automatic fallback ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
# Free key from https://console.groq.com (optional fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_ENABLED=true

# --- MCP bridge ---
MCP_HTTP_URL=http://127.0.0.1:8091
CORS_ORIGINS=http://localhost:5200,http://127.0.0.1:5200

# --- Neo4j Community (GraphRAG + VectorRAG) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=servicenowai-neo4j
NEO4J_DATABASE=neo4j
NEO4J_ENABLED=true
NEO4J_URI_A=bolt://localhost:7687
NEO4J_USERNAME_A=neo4j
NEO4J_PASSWORD_A=servicenowai-neo4j
NEO4J_DATABASE_A=neo4j
NEO4J_ENABLED_A=true

GRAPHRAG_V2_ENABLED=true
GRAPHRAG_VECTOR_ENABLED=false
VECTORRAG_ENABLED=true

# A PDI is not reachable from the internet, so poll for catalog changes instead of using webhooks.
CATALOG_POLLING_ENABLED=true
DEBUG=false
